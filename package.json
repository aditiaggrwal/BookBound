{
  "name": "bookbound",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @bookbound/web build && node scripts/migrate-app.mjs",
    "start": "tsx apps/api/src/server.ts",
    "test": "node scripts/run.mjs test",
    "typecheck": "node scripts/run.mjs typecheck",
    "db:migrate": "node scripts/migrate-app.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "pg": "^8.20.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0"
  }
}
