{
  "name": "bookbound",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @bookbound/web build && node scripts/bundle-api.mjs && node scripts/migrate-app.mjs",
    "start": "tsx apps/api/src/server.ts",
    "test": "node scripts/run.mjs test",
    "typecheck": "node scripts/run.mjs typecheck",
    "db:migrate": "node scripts/migrate-app.mjs"
  },
  "dependencies": {
    "@bookbound/db": "workspace:*",
    "@bookbound/shared": "workspace:*",
    "@bookbound/worker": "workspace:*",
    "@electric-sql/pglite": "^0.3.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.20.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.18.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
