# Leave DATABASE_URL unset to use in-memory PGlite locally.
# Cursor Apps sets DATABASE_URL automatically when the app is published with a database.
DATABASE_URL=
API_PORT=8787
PORT=8787
# Local Docker Compose only. Required when starting postgres via docker compose.
POSTGRES_USER=bookbound
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookbound
POSTGRES_PORT=5432
# fixture uses no model spend. Set gemini, openai, or anthropic and the matching key for real tags.
LLM_PROVIDER=fixture
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GOOGLE_BOOKS_API_KEY=
# Defaults to Secure cookies in production/HTTPS. Set false only for local http:// testing.
COOKIE_SECURE=
# Optional. Required to use /api/review/* admin tagging review routes.
REVIEW_ADMIN_TOKEN=
